{
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "X-Robots-Tag", "value": "noindex" }
    ] },
    { "source": "/(app.js|app.css|config.js|sw.js|index.html)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
