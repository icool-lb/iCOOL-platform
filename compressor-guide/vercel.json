{
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ] },
    { "source": "/data.enc", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
  ]
}
